<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup (android:dataExtractionRules). Scan E4.
     Same exclusions for cloud backup AND device-to-device transfer: the
     sign-in session (tokens, user id, "logged in" flag, pending order) stays
     on this phone. A restored or new phone starts signed out.
     Keep in sync with backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <exclude domain="file" path="datastore/flutter_preferences.preferences_pb" />
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <exclude domain="file" path="datastore/flutter_preferences.preferences_pb" />
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
    </device-transfer>
</data-extraction-rules>
