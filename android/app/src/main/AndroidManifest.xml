<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <application
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:label="Aorbo Treks"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- resizeableActivity=false: the UI is fixed-layout (sizer %s, no
             reflow); a narrow split-screen pane on a phone squeezes rows
             past their content and stripes them, so opt out of
             freeform/split-screen. NOTE: Android 16+ (targetSdk 36) ignores
             this on large screens >600dp (tablets/foldables) — those are
             covered by the app-side font-scale clamp in app_typography.dart.
             This still takes effect for phone split-screen. -->
        <activity
            android:name=".MainActivity"
            android:enableOnBackInvokedCallback="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:exported="true"
            android:resizeableActivity="false"
            android:hardwareAccelerated="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Referral links https://<host>/r/<CODE> (Aorbo Trek Giveaway +
                 Refer & Earn), handled by lib/giveaway/referral_links.dart.
                 Verified https App Links only — no custom scheme another app
                 could also register. EVERY host below must serve
                 /.well-known/assetlinks.json with the Play App Signing
                 certificate's SHA-256 (Play Console → App integrity), not the
                 upload key; on Android 11 and lower one failing host stops
                 all of them from opening the app. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="aorbotreks.co.in" />
                <data android:host="api.aorbotreks.co.in" />
                <data android:pathPrefix="/r/" />
            </intent-filter>
            <!-- Links are read by the app_links plugin, not pushed onto the
                 Flutter navigator as routes. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- AdMob App ID. Real Android app id (must match
             lib/config/ad_config.dart's _realAppIdAndroid). Ad *unit*
             requests still use Google's test unit id until
             AdConfig.useRealAds is flipped — the manifest App ID and the
             ad unit id are independent; Google's test unit ids work under
             any App ID. Omitting this meta-data crashes the app on start. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-1409410183966075~2943255858" />
        <!-- Delay ad SDK init to our own MobileAds.instance.initialize()
             call (in _deferredInit) so it never competes with the first
             frame / cold start. -->
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
            android:value="true" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING"
            android:value="true" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Required since Android 11 (API 30) package-visibility rules —
             without this, the app cannot resolve/launch installed UPI apps
             via intent for Razorpay's UPI checkout. Missing this exactly
             explains "works for GPay/Paytm/cards, hangs only on PhonePe":
             Razorpay's SDK bundles its own <queries> for some well-known UPI
             apps, but this app's own manifest declared none, so any UPI app
             not already covered by Razorpay's bundled list becomes
             unresolvable and the payment intent hand-off silently fails. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
        <package android:name="com.phonepe.app" />
    </queries>
    <!-- Disabled 2026-08-24: confirmed via logcat that on a budget Unisoc
         device (Samsung SM-A035F / Galaxy A03) Impeller's Vulkan backend
         renders a blank gray screen — the app process runs fine (no crash,
         "Fully drawn" in ~460ms) but nothing ever paints. Weak/buggy Vulkan
         driver support on low-end Unisoc/MediaTek GPUs is a known Impeller
         compatibility gap. Falling back to the legacy Skia/OpenGL backend,
         which has much broader real-device coverage — a working app on
         budget hardware matters more than Impeller's smoother animations,
         especially now that the splash animation itself no longer relies
         on any shader effects (Shimmer/ShaderMask removed this session). -->
    <meta-data
        android:name="io.flutter.embedding.android.EnableImpeller"
        android:value="false" />
</manifest>
